oter-card-desc {\n  font-size: 11.5px;\n  color: var(--text-muted);\n  line-height: 1.4;\n}\n\n/* ==========================================================================\n   Main Content Area\n   ========================================================================== */\n\n.main-container {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0; /* Prevents flex children blowout */\n}\n\n/* Top Header */\n.top-header {\n  height: var(--header-height);\n  padding: 0 36px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--border-light);\n  background-color: #ffffff;\n  position: sticky;\n  top: 0;\n  z-index: 30;\n}\n\n.breadcrumbs {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13.5px;\n}\n\n.breadcrumb-parent {\n  color: var(--text-muted);\n  font-weight: 500;\n}\n\n.breadcrumb-separator {\n  color: var(--text-placeholder);\n}\n\n.breadcrumb-current {\n  color: var(--text-main);\n  font-weight: 600;\n}\n\n.user-profile {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.avatar-circle {\n  width: 38px;\n  height: 38px;\n  border-radius: var(--radius-full);\n  background: linear-gradient(135deg, #c7d2fe 0%, #a5b4fc 100%);\n  color: #312e81;\n  font-weight: 700;\n  font-size: 13px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 2px solid #ffffff;\n  box-shadow: var(--shadow-sm);\n  cursor: pointer;\n}\n\n/* Dashboard Body */\n.dashboard-content {\n  padding: 32px 36px 60px;\n  max-width: 1200px;\n  width: 100%;\n  margin: 0 auto;\n}\n\n/* Page Title & Action Bar */\n.dashboard-hero {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 24px;\n}\n\n.hero-title {\n  font-size: 28px;\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--text-main);\n  margin-bottom: 4px;\n}\n\n.hero-subtitle {\n  font-size: 14.5px;\n  color: var(--text-muted);\n}\n\n/* Buttons */\n.primary-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  background-color: var(--color-primary);\n  color: #ffffff;\n  font-size: 14px;\n  font-weight: 600;\n  padding: 10px 18px;\n  border-radius: var(--radius-md);\n  box-shadow: 0 1px 2px rgba(79, 70, 229, 0.2);\n  white-space: nowrap;\n}\n\n.primary-btn:hover {\n  background-color: var(--color-primary-hover);\n  box-shadow: 0 4px 10px var(--color-primary-glow);\n}\n\n.secondary-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  background-color: #ffffff;\n  border: 1px solid var(--border-light);\n  color: var(--text-secondary);\n  font-size: 14px;\n  font-weight: 500;\n  padding: 9px 16px;\n  border-radius: var(--radius-md);\n}\n\n.secondary-btn:hover {\n  background-color: #f8fafc;\n  border-color: #cbd5e1;\n  color: var(--text-main);\n}\n\n/* ==========================================================================\n   Focus Notes Carousel\n   ========================================================================== */\n\n.focus-notes-banner {\n  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 60%, #4338ca 100%);\n  border-radius: var(--radius-xl);\n  padding: 24px 28px;\n  color: #ffffff;\n  position: relative;\n  overflow: hidden;\n  box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.28);\n  margin-bottom: 24px;\n}\n\n/* Decorative subtle background aura */\n.focus-notes-banner::before {\n  content: '';\n  position: absolute;\n  top: -40%;\n  right: -10%;\n  width: 320px;\n  height: 320px;\n  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 70%);\n  border-radius: 50%;\n  pointer-events: none;\n}\n\n.carousel-slide-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  position: relative;\n  z-index: 2;\n}\n\n.slide-text-col {\n  flex: 1;\n}\n\n.slide-tag {\n  display: inline-block;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: rgba(255, 255, 255, 0.85);\n  margin-bottom: 8px;\n}\n\n.slide-title {\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  margin-bottom: 4px;\n  color: #ffffff;\n}\n\n.slide-subtitle {\n  font-size: 13.5px;\n  color: rgba(255, 255, 255, 0.82);\n}\n\n/* Floating Task Preview Card inside Carousel */\n.slide-preview-card {\n  background-color: #ffffff;\n  color: var(--text-main);\n  border-radius: var(--radius-md);\n  padding: 14px 18px;\n  min-width: 210px;\n  max-width: 240px;\n  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);\n}\n\n.preview-badge {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  padding: 3px 8px;\n  border-radius: var(--radius-full);\n  display: inline-block;\n  margin-bottom: 8px;\n}\n\n.preview-title {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--text-main);\n  margin-bottom: 10px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.preview-progress-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.preview-progress-track {\n  flex: 1;\n  height: 6px;\n  background-color: #f1f5f9;\n  border-radius: var(--radius-full);\n  overflow: hidden;\n}\n\n.preview-progress-fill {\n  height: 100%;\n  border-radius: var(--radius-full);\n  transition: width 0.4s ease;\n}\n\n.preview-percent {\n  font-size: 11px;\n  font-weight: 700;\n  color: var(--text-muted);\n}\n\n/* Carousel Arrow Controls */\n.carousel-controls {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.carousel-arrow-btn {\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-full);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #ffffff;\n  background-color: rgba(255, 255, 255, 0.18);\n  backdrop-filter: blur(4px);\n  border: 1px solid rgba(255, 255, 255, 0.25);\n}\n\n.carousel-arrow-btn:hover {\n  background-color: rgba(255, 255, 255, 0.3);\n}\n\n.carousel-arrow-btn.next-btn {\n  background-color: #ffffff;\n  color: var(--color-primary);\n  border: none;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);\n}\n\n.carousel-arrow-btn.next-btn:hover {\n  background-color: #f8fafc;\n  transform: scale(1.05);\n}\n\n.carousel-indicators {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  margin-top: 14px;\n}\n\n.carousel-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: var(--radius-full);\n  background-color: rgba(255, 255, 255, 0.4);\n  padding: 0;\n  transition: all 0.2s ease;\n}\n\n.carousel-dot.active {\n  width: 18px;\n  background-color: #ffffff;\n}\n\n/* ==========================================================================\n   Overview Statistics Cards\n   ========================================================================== */\n\n.overview-stats-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n  margin-bottom: 32px;\n}\n\n.stat-card {\n  background-color: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: var(--radius-lg);\n  padding: 20px 22px;\n  box-shadow: var(--shadow-card);\n  transition: transform 0.18s ease, box-shadow 0.18s ease;\n}\n\n.stat-card:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-md);\n}\n\n.stat-card-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n\n.stat-icon-wrapper {\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-md);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.stat-card-title {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--text-secondary);\n}\n\n.stat-card-body {\n  display: flex;\n  align-items: baseline;\n  gap: 10px;\n}\n\n.stat-card-value {\n  font-size: 32px;\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  color: var(--text-main);\n  line-height: 1;\n}\n\n.stat-card-subtitle {\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n/* ==========================================================================\n   My Tasks Section\n   ========================================================================== */\n\n.tasks-section-header {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  margin-bottom: 16px;\n}\n\n.tasks-section-title {\n  font-size: 20px;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  color: var(--text-main);\n  margin-bottom: 2px;\n}\n\n.tasks-section-subtitle {\n  font-size: 13.5px;\n  color: var(--text-muted);\n}\n\n.view-all-link {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--color-primary);\n  text-decoration: none;\n  cursor: pointer;\n}\n\n.view-all-link:hover {\n  text-decoration: underline;\n}\n\n/* Filter and Search Bar Row */\n.tasks-filter-bar {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 20px;\n}\n\n.filter-controls-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  flex-wrap: wrap;\n}\n\n.status-tabs-list {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  overflow-x: auto;\n  padding-bottom: 2px;\n}\n\n.status-tab-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 14px;\n  font-size: 13.5px;\n  font-weight: 500;\n  color: var(--text-secondary);\n  border-radius: var(--radius-md);\n  background-color: transparent;\n  white-space: nowrap;\n}\n\n.status-tab-btn:hover {\n  background-color: #f1f5f9;\n  color: var(--text-main);\n}\n\n.status-tab-btn.active {\n  background-color: #ffffff;\n  color: var(--color-primary);\n  font-weight: 600;\n  box-shadow: var(--shadow-sm);\n  border: 1px solid var(--border-light);\n}\n\n.tab-count-badge {\n  font-size: 11.5px;\n  font-weight: 600;\n  padding: 1px 7px;\n  border-radius: var(--radius-full);\n  background-color: #f1f5f9;\n  color: var(--text-muted);\n}\n\n.tab-count-badge.active-badge {\n  background-color: var(--color-primary-light);\n  color: var(--color-primary);\n}\n\n.filter-actions-right {\n  displa